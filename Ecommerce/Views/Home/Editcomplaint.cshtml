@model Complaint
<h2 class="text-primary align:center text-decoration:underline mb-3" >Welcome To The Complaint Section</h2>
<form asp-action="EditComplaint" method="post">

    <input type="hidden" asp-for="Id" />

    
    <div class="mb-3">

        <label class="fw-bolder underline mb-2">Email Address or UserName</label>

        <input asp-for="Email"
               class="form-control"/>

    </div>

    <div class="mb-3">

        <label  class="fw-bolder underline mb-2">Subject</label>

        <input asp-for="Subject"
               class="form-control"/>

    </div>

    <div class="mb-3">

        <label  class="fw-bolder underline mb-2">Description</label>

        <textarea asp-for="Description"
                  class="form-control">
        </textarea>

    </div>

    <button type="submit"
            class="btn btn-primary">

      Update

    </button>

</form>