@model IEnumerable<Ecommerce.Models.Complaint>

@{
    ViewData["Title"] = "My Complaints";
}

<div class="container py-4">

    <h2 class="mb-4">My Complaints</h2>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Subject</th>
                        <th>Description</th>
                        <th>Email</th>
                        <th>Created At</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var complaint in Model)
                    {
                        <tr>
                            <td>@complaint.Subject</td>
                            <td>@complaint.Description</td>
                            <td>@complaint.Email</td>
                            <td>@complaint.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</td>
                        </tr>

                    
                    }
                    <tr>
                        <div>
            
        </div>
                    </tr>
                </tbody>
            </table>

            <form asp-action="NewComplaint" asp-controller="Home">
            <button class="btn btn-primary">Register a Complaint</button>
            </form>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            You have not raised any complaints yet.
        </div>

        <br/>
        <br/>

        <div>
            <form asp-action="NewComplaint" asp-controller="Home">
            <button class="btn btn-primary">Register a Complaint</button>
            </form>
        </div>
    }

</div>