@{
    ViewData["Title"] = "Home Page";
}

@model IEnumerable<Product>

<style>
    :root {
        --shop-dark: #0f172a;
        --shop-purple: #7c3aed;
        --shop-pink: #ec4899;
        --shop-green: #22c55e;
    }

    body {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 55%, #312e81 100%);
        color: #f8fafc;
        min-height: 100vh;
    }

    .hero-section {
        padding: 70px 20px 40px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3.2rem);
        font-weight: 800;
        letter-spacing: 1px;
        background: linear-gradient(90deg, #facc15, #ec4899, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin-bottom: 18px;
    }

    .hero-text {
        max-width: 780px;
        margin: 0 auto;
        font-size: 1.15rem;
        color: #cbd5e1;
    }

    .welcome-card {
        max-width: 950px;
        margin: 45px auto 0;
        padding: 40px 30px;
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(14px);
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
    }

    .welcome-card h3 {
        font-weight: 800;
        color: #ffffff;
    }

    .welcome-card p,
    .welcome-card li {
        color: #e2e8f0;
    }

    .feature-list li {
        margin-bottom: 10px;
    }

    .feature-icon {
        color: var(--shop-green);
        margin-right: 8px;
    }

    .slider-wrapper {
        max-width: 1150px;
        margin: 60px auto;
        padding: 0 15px;
    }

    .product-carousel {
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .product-carousel img {
    width: 100%;
    height: 420px;
    object-fit: contain;
    object-position: center;
    background-color: #ffffff;
    padding: 10px;
}

    .carousel-caption {
        background: rgba(15, 23, 42, 0.72);
        border-radius: 16px;
        padding: 18px 22px;
        backdrop-filter: blur(8px);
    }

    .carousel-caption h5 {
        font-weight: 700;
        color: #ffffff;
    }

    .carousel-caption p {
        color: #facc15;
        font-weight: 700;
        margin-bottom: 0;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: rgba(124, 58, 237, 0.85);
        border-radius: 50%;
        padding: 18px;
        background-size: 55%;
    }

    .carousel-indicators [data-bs-target] {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: rgba(255, 255, 255, 0.5);
        border: none;
    }

    .carousel-indicators .active {
        background-color: var(--shop-pink);
    }

    .section-title {
        text-align: center;
        font-weight: 800;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        margin-bottom: 40px;
    }

    .section-title span {
        background: linear-gradient(90deg, #22c55e, #38bdf8);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .feature-card {
        height: 100%;
        padding: 32px 24px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-10px);
        background: rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 45px rgba(124, 58, 237, 0.35);
    }

    .feature-card i {
        font-size: 2.4rem;
        color: var(--shop-purple);
        margin-bottom: 18px;
    }

    .feature-card h5 {
        font-weight: 700;
        color: #ffffff;
    }

    .feature-card p {
        color: #cbd5e1;
        margin-bottom: 0;
    }

    .cta-section {
        max-width: 950px;
        margin: 70px auto;
        padding: 50px 30px;
        border-radius: 24px;
        text-align: center;
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.9), rgba(236, 72, 153, 0.85));
        box-shadow: 0 25px 60px rgba(124, 58, 237, 0.4);
    }

    .cta-section h2 {
        font-weight: 800;
        color: #ffffff;
    }

    .cta-section p {
        color: #f1f5f9;
        font-size: 1.1rem;
    }

    .btn-shop {
        background-color: #ffffff;
        color: #1e1b4b;
        font-weight: 700;
        padding: 12px 32px;
        border-radius: 50px;
        border: none;
        transition: all 0.3s ease;
    }

    .btn-shop:hover {
        background-color: #facc15;
        color: #0f172a;
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.25);
    }

    @@media (max-width: 768px) {
        .product-carousel img {
            height: 260px;
        }

        .welcome-card {
            padding: 28px 20px;
        }
    }

    .typing-cursor {
    color: #facc15;
    font-weight: 800;
    animation: blinkCursor 0.8s step-end infinite;
}

@@keyframes blinkCursor {
    0%, 100% {
        opacity: 1;
    }

    50% {
        opacity: 0;
    }
}

</style>



<div class="hero-section">

  <h1 class="hero-title text-danger fw-bolder">
    <span id="typingText"></span><span class="typing-cursor">|</span>
</h1>
<br/>
<form asp-action="Guide" asp-controller="Home"  >
<button class="btn btn-primary">Guide</button>
</form>
<br/><br/>
    <p class="hero-text">
        Discover a seamless shopping experience designed for you. From trending fashion
        to electronics, home appliances, and daily essentials — everything you need is
        available in one place.
    </p>

    <div class="welcome-card">
        <h3>
            Hello Shopper! <span class="text-warning">Welcome to Ecommerce-Cart</span>
        </h3>

        <p class="mt-3">
            Your trusted online marketplace for quality products, great prices,
            and a smooth shopping experience.
        </p>

        <ul class="feature-list list-unstyled mt-4 text-start mx-auto" style="max-width: 640px;">
            <li><i class="bi bi-check-circle-fill feature-icon"></i> Top-quality products from trusted sellers</li>
            <li><i class="bi bi-check-circle-fill feature-icon"></i> Best prices with exciting offers</li>
            <li><i class="bi bi-check-circle-fill feature-icon"></i> Fast delivery across all locations</li>
            <li><i class="bi bi-check-circle-fill feature-icon"></i> Secure payments and easy checkout</li>
            <li><i class="bi bi-check-circle-fill feature-icon"></i> 24/7 customer support</li>
        </ul>
    </div>
</div>

<div class="slider-wrapper">
    <div id="productSlider" class="carousel slide product-carousel" data-bs-ride="carousel" data-bs-interval="3000">

        <div class="carousel-indicators">
            @for (int i = 0; i < Model.Count(); i++)
            {
                <button type="button"
                        data-bs-target="#productSlider"
                        data-bs-slide-to="@i"
                        class="@(i == 0 ? "active" : "")"
                        aria-current="@(i == 0 ? "true" : "false")"
                        aria-label="Slide @(i + 1)">
                </button>
            }
        </div>

        <div class="carousel-inner">
            @foreach (var item in Model.Select((value, index) => new { value, index }))
            {
                <div class="carousel-item @(item.index == 0 ? "active" : "")">
                    <img src="@item.value.ImageUrl"
                         alt="@item.value.Name"
                         class="d-block w-100" />

                    <div class="carousel-caption d-none d-md-block">
                        <h5>@item.value.Name</h5>
                        <p>@item.value.Price.ToString("C")</p>
                    </div>
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button"
                data-bs-target="#productSlider"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button"
                data-bs-target="#productSlider"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>

<div class="container pb-5">
    <h2 class="section-title">
        Why Choose <span>Ecommerce-Cart?</span>
    </h2>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-shield-check"></i>
                <h5>Secure Shopping</h5>
                <p>Shop confidently with safe payments and protected customer information.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-tags-fill"></i>
                <h5>Best Prices</h5>
                <p>Enjoy regular discounts, special offers, and great value for every product.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-truck"></i>
                <h5>Fast Delivery</h5>
                <p>Get your favorite products delivered quickly and reliably to your location.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-headset"></i>
                <h5>24/7 Support</h5>
                <p>Our support team is always ready to help you whenever you need assistance.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-stars"></i>
                <h5>Quality Products</h5>
                <p>We offer carefully selected products from reliable and trusted sellers.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="feature-card">
                <i class="bi bi-heart-fill"></i>
                <h5>Customer First</h5>
                <p>Your satisfaction is our priority, and your trust is our strength.</p>
            </div>
        </div>
    </div>

    <div class="cta-section">
        <h2>Ready to Start Shopping?</h2>

        <p class="mt-3">
            Explore the latest products, discover amazing deals, and enjoy a simple,
            fast, and secure shopping experience.
        </p>

        <a asp-controller="User" asp-action="Index" class="btn btn-shop mt-4">
            Browse Products
        </a>
    </div>
</div>

                <script>
    const typingText = document.getElementById("typingText");
    const message = "Welcome To The Best Shopping Website !";

    let index = 0;

    function typeLetter() {
        if (index < message.length) {
            typingText.textContent += message[index];
            index++;
        } else {
            clearInterval(typingInterval);
        }
    }

    const typingInterval = setInterval(typeLetter, 100);
</script>