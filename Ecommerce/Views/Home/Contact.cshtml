@{
    ViewData["Title"] = "Contact";
}

<style>
    .contact-hero {
        text-align: center;
        padding: 70px 20px 30px;
    }

    .contact-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        background: linear-gradient(90deg, #facc15, #ec4899, #7c3aed);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .contact-subtitle {
        color: #cbd5e1;
        max-width: 750px;
        margin: 15px auto 0;
        font-size: 1.1rem;
    }

    .profile-card {
        max-width: 1000px;
        margin: 40px auto;
        padding: 40px 30px;
        border-radius: 25px;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.16);
        backdrop-filter: blur(18px);
        box-shadow: 0 30px 70px rgba(0, 0, 0, 0.4);
    }

    .profile-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 3rem;
        color: #ffffff;
        background: linear-gradient(135deg, #7c3aed, #ec4899);
        box-shadow: 0 20px 45px rgba(124, 58, 237, 0.45);
    }

    .profile-name {
        color: #ffffff;
        font-weight: 800;
        font-size: 1.8rem;
        text-align: center;
    }

    .profile-role {
        text-align: center;
        color: #facc15;
        font-weight: 600;
        margin-bottom: 25px;
    }

    .about-text {
        color: #e2e8f0;
        line-height: 1.8;
        font-size: 1.05rem;
    }

    .info-card {
        height: 100%;
        padding: 28px 22px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.07);
        border: 1px solid rgba(255, 255, 255, 0.14);
        transition: all 0.3s ease;
    }

    .info-card:hover {
        transform: translateY(-8px);
        background: rgba(255, 255, 255, 0.12);
        box-shadow: 0 20px 45px rgba(124, 58, 237, 0.35);
    }

    .info-icon {
        width: 60px;
        height: 60px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        color: #ffffff;
        margin-bottom: 18px;
        background: linear-gradient(135deg, #7c3aed, #ec4899);
    }

    .info-card h5 {
        color: #ffffff;
        font-weight: 700;
    }

    .info-card p {
        color: #cbd5e1;
        margin-bottom: 0;
    }

    .skill-badge {
        display: inline-block;
        padding: 8px 16px;
        margin: 6px 5px;
        border-radius: 50px;
        font-weight: 600;
        color: #ffffff;
        background: rgba(124, 58, 237, 0.25);
        border: 1px solid rgba(124, 58, 237, 0.55);
        transition: all 0.25s ease;
    }

    .skill-badge:hover {
        background: linear-gradient(90deg, #7c3aed, #ec4899);
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(236, 72, 153, 0.35);
    }

    .contact-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 13px 28px;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .email-btn {
        background: linear-gradient(90deg, #7c3aed, #ec4899);
        color: #ffffff;
    }

    .email-btn:hover {
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(236, 72, 153, 0.4);
    }

    .whatsapp-btn {
        background-color: #22c55e;
        color: #ffffff;
    }

    .whatsapp-btn:hover {
        color: #ffffff;
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(34, 197, 94, 0.4);
    }

    .section-heading {
        color: #ffffff;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .experience-list li {
        color: #e2e8f0;
        margin-bottom: 12px;
        line-height: 1.7;
    }

    .experience-list i {
        color: #22c55e;
        margin-right: 8px;
    }

    @@media (max-width: 768px) {
        .profile-card {
            padding: 30px 20px;
        }

        .profile-name {
            font-size: 1.5rem;
        }
    }
</style>

