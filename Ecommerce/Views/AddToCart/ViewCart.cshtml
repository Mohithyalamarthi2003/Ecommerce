@model IEnumerable<CartItem>

<div class="container py-4">
    <h2 class="fw-bolder text-center text-decoration-underline mb-4">
        Welcome to the View Cart
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            <i class="bi bi-cart-x me-2"></i>
            Your cart is empty.
        </div>

        <div class="text-center">
            <a asp-controller="User"
               asp-action="Index"
               class="btn btn-primary">
                <i class="bi bi-grid me-1"></i> Continue Shopping
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded-3">
            <table class="table align-middle mb-0 bg-white">
                <thead class="table-dark">
                    <tr>
                        <th>Product</th>
                        <th class="text-center">Price</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Total</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        var product = item.Product;
                        var lineTotal = (product?.Price ?? 0) * item.Quantity;

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(product?.ImageUrl ?? "/images/no-image.png")"
                                         alt="@(product?.Name ?? "Product")"
                                         class="rounded"
                                         style="width: 75px; height: 75px; object-fit: contain; background-color: #f8f9fa;" />

                                    <div>
                                        <div class="fw-bold">
                                            @(product?.Name ?? "Product unavailable")
                                        </div>

                                        <div class="text-muted small">
                                            @(product?.Description ?? "")
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <td class="text-center fw-semibold">
                                @((product?.Price ?? 0).ToString("C"))
                            </td>

                            <td class="text-center">
                                <form asp-controller="Cart"
                                      asp-action="UpdateQuantity"
                                      method="post"
                                      class="d-flex justify-content-center align-items-center gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@item.Id" />

                                    <input type="number"
                                           name="quantity"
                                           value="@item.Quantity"
                                           min="1"
                                           max="100"
                                           class="form-control text-center"
                                           style="width: 85px;" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary" asp-action="Update" asp-controller="AddToCart" asp-route-id="@item.Id">
                                        Update
                                    </button>
                                </form>
                            </td>

                            <td class="text-center fw-bold text-success">
                                @lineTotal.ToString("C")
                            </td>

                            <td class="text-center">
                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post"
                                      onsubmit="return confirm('Remove this item from your cart?');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@item.Id" />

                                    <button type="submit" asp-action="Remove" asp-controller="AddToCart" asp-route-id="@item.Id"
                                            class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash me-1"></i> Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

                <tfoot class="table-light">
                    <tr>
                        <td colspan="3" class="text-end fw-bold">
                            Grand Total:
                        </td>

                        <td class="text-center fw-bold text-success">
                            @Model.Sum(item => (item.Product?.Price ?? 0) * item.Quantity).ToString("C")
                        </td>

                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap gap-2">
            <a asp-controller="User"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Continue Shopping
            </a>

            <a asp-controller="Order"
               asp-action="Checkout"
               class="btn btn-success btn-lg">
                <i class="bi bi-credit-card me-1"></i> Proceed to Checkout
            </a>
        </div>
    }
</div>