@model LoginModel

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: "Segoe UI", sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .auth-card {
        width: 100%;
        max-width: 430px;
        background: rgba(255, 255, 255, 0.96);
        border-radius: 20px;
        padding: 40px 32px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        animation: fadeInUp 0.6s ease;
    }

    .auth-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: #fff;
        font-size: 34px;
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }

    .auth-title {
        text-align: center;
        font-weight: 700;
        color: #2d3436;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        text-align: center;
        color: #636e72;
        font-size: 15px;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-weight: 600;
        font-size: 14px;
        color: #2d3436;
        margin-bottom: 8px;
        display: block;
    }

    .input-box {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: #764ba2;
        font-size: 18px;
        pointer-events: none;
    }

    .auth-input {
        width: 100%;
        height: 50px;
        padding-left: 45px;
        border-radius: 12px;
        border: 1.5px solid #dfe6e9;
        background-color: #f8f9fa;
        color: #2d3436;
        font-size: 15px;
        transition: all 0.25s ease;
    }

        .auth-input:focus {
            border-color: #764ba2;
            background-color: #fff;
            box-shadow: 0 0 0 4px rgba(118, 75, 162, 0.15);
            outline: none;
        }

    .auth-btn {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 16px;
        color: #fff;
        background: linear-gradient(135deg, #667eea, #764ba2);
        box-shadow: 0 10px 25px rgba(102, 126, 234, 0.35);
        transition: all 0.25s ease;
        cursor: pointer;
    }

        .auth-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(102, 126, 234, 0.45);
        }

    .secondary-btn {
        width: 100%;
        height: 50px;
        border-radius: 12px;
        border: 1.5px solid #764ba2;
        color: #764ba2;
        font-weight: 600;
        background: transparent;
        transition: all 0.25s ease;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .secondary-btn:hover {
            background: #764ba2;
            color: #fff;
            transform: translateY(-2px);
        }

    .validation-summary,
    .validation-message {
        color: #d63031;
        font-size: 13px;
        margin-top: 6px;
    }

    .validation-summary {
        margin-bottom: 15px;
    }

    .remember-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        font-size: 14px;
        color: #636e72;
    }

        .remember-row input {
            accent-color: #764ba2;
        }

    .forgot-link {
        color: #764ba2;
        font-weight: 600;
        text-decoration: none;
    }

        .forgot-link:hover {
            text-decoration: underline;
        }

    .divider {
        display: flex;
        align-items: center;
        margin: 22px 0;
        color: #b2bec3;
        font-size: 13px;
    }

        .divider::before,
        .divider::after {
            content: "";
            flex: 1;
            height: 1px;
            background: #dfe6e9;
        }

        .divider span {
            padding: 0 12px;
        }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(25px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 576px) {
        .auth-card {
            padding: 30px 20px;
        }

        .auth-icon {
            width: 65px;
            height: 65px;
            font-size: 28px;
        }
    }
</style>

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-icon">
            <i class="bi bi-person-circle"></i>
        </div>

        <h2 class="auth-title">Welcome Back</h2>
        <p class="auth-subtitle">Login to continue shopping</p>

        <form asp-action="Login"
              asp-controller="Account"
              method="post">

            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email" class="form-label">
                    <i class="bi bi-envelope me-2"></i>Email Address
                </label>

                <div class="input-box">
                    <i class="bi bi-envelope input-icon"></i>

                    <input asp-for="Email"
                           class="form-control auth-input"
                           placeholder="Enter your email"
                           autocomplete="email" />
                </div>

                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="form-label">
                    <i class="bi bi-lock me-2"></i>Password
                </label>

                <div class="input-box">
                    <i class="bi bi-lock input-icon"></i>

                    <input asp-for="Password"
                           type="password"
                           class="form-control auth-input"
                           placeholder="Enter your password"
                           autocomplete="current-password" />
                </div>

                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="remember-row">
                <label>
                    <input type="checkbox" name="RememberMe" /> Remember me
                </label>

                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   class="forgot-link">
                    Forgot password?
                </a>
            </div>

            <button type="submit" class="auth-btn">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </button>

            <div class="divider">
                <span>or</span>
            </div>

            <a asp-controller="Account"
               asp-action="Register"
               class="secondary-btn">
                <i class="bi bi-person-plus me-2"></i>Create New Account
            </a>

        </form>
    </div>
</div>