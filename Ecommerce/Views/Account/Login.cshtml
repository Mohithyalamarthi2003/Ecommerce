@model LoginModel
<h2>Welcome to the Login Page</h2>

<form asp-action="Login" asp-controller="Account" method="post">
  

    <div class="form-group mt-3">
        <label for="exampleInputEmail1">Email address</label>
        <input asp-for="Email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email">
        <span asp-validation-for="Email" class="text-danger"></span>   
    </div>

    <div class="form-group mt-3">
        <label for="exampleInputPassword1">Password</label>
        <input asp-for="Password" type="password" class="form-control" id="exampleInputPassword1" placeholder="Password">
    <span asp-validation-for="Password" class="text-danger"></span>
    </div>

      <div asp-validation-summary="All" class="text-danger"></div>
 
    <button type="submit" class="btn btn-primary mt-3">Submit</button>
</form>