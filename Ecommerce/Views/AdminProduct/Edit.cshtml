@model Product;

<h2 class="text-primary m-0 text-black text-decoration-underline text-align-center">Welcome to the product Edit Page</h2>


<div>

    <form class="mt-3" asp-action="Edit" method="post" asp-controller="AdminProduct" enctype="multipart/form-data">

        <div class="form-group">
            <label class="mb-2">Product Name</label>
            <input asp-for="Name" class="form-control mb-4" placeholder="Enter Product Name">
        </div>
        
        <div class="form-group">
            <label class="mb-2">Product Description</label>
            <input asp-for="Description" class="form-control mb-4" placeholder="Description">
        </div>

        <div class="form-group">
            <label class="mb-2">Available Stock</label>
            <input asp-for="AvailableQuantity" class="form-control mb-4">
        </div>

        <div class="form-group">
            <label class="mb-2">Price</label>
            <input asp-for="Price" class="form-control mb-4">
        </div>

        <div class="form-group">
            <label class="mb-2">Choose an Product image</label>
            <input asp-for="Image" type="file" />
        </div>

        <button type="submit" class="btn btn-primary mt-4">Update</button>

    </form>


</div>

