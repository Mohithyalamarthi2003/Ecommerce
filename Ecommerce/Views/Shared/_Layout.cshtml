<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            html,
            body {
                width: 100%;
                min-height: 100%;
                margin: 0;
                padding: 0;
            }

            body {
                min-height: 100vh;
                background-color: #f4f7fb;
                overflow-x: hidden;
            }

            /* =========================
                       NAVBAR
                       ========================= */

            .modern-navbar {
                background: #0f172a;
                border-bottom: 1px solid rgba(255, 255, 255, 0.12);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
            }

            .brand-logo {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: #ffffff !important;
                font-size: 1.45rem;
                font-weight: 800;
                text-decoration: none;
                white-space: nowrap;
            }

            .brand-icon {
                color: #ec4899;
                font-size: 1.6rem;
            }

            .brand-accent {
                color: #ec4899;
            }

            .modern-link {
                display: inline-block;
                margin: 0 4px;
                padding: 8px 16px !important;
                border-radius: 50px;
                color: #e2e8f0 !important;
                font-weight: 600;
                text-decoration: none;
                transition: all 0.25s ease;
            }

                .modern-link:hover,
                .modern-link.active {
                    background: linear-gradient(90deg, rgba(124, 58, 237, 0.9), rgba(236, 72, 153, 0.9));
                    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.35);
                    color: #ffffff !important;
                    transform: translateY(-2px);
                }

            .cart-badge {
                display: inline-block;
                min-width: 12px;
                min-height: 12px;
                margin-left: 4px;
                padding: 2px 7px;
                border-radius: 50px;
                background-color: #facc15;
                color: #0f172a;
                font-size: 0.72rem;
                font-weight: 700;
            }

            .custom-toggler {
                border-color: rgba(255, 255, 255, 0.45);
                box-shadow: none !important;
            }

                .custom-toggler .navbar-toggler-icon {
                    filter: invert(1);
                }

            .auth-nav-area {
                display: flex;
                align-items: center;
                justify-content: flex-end;
                gap: 14px;
                flex-shrink: 0;
            }

            .logged-user {
                color: #34d399;
                font-weight: 700;
                text-decoration: underline;
                white-space: nowrap;
            }

            .login-btn {
                padding: 8px 22px;
                border: 1px solid rgba(255, 255, 255, 0.35);
                border-radius: 50px;
                color: #ffffff;
                font-weight: 600;
                transition: all 0.25s ease;
            }

                .login-btn:hover {
                    background-color: rgba(255, 255, 255, 0.12);
                    color: #ffffff;
                    transform: translateY(-2px);
                }

            /* =========================
                       FOOTER
                       ========================= */

            .site-footer {
                width: 100%;
                margin-top: auto;
                flex-shrink: 0;
                color: #cbd5e1;
                background: #0f172a;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
            }

            .footer-content {
                display: grid;
                grid-template-columns: 1.5fr 1fr 1.2fr;
                gap: 45px;
                padding: 45px 0 35px;
            }

            .footer-logo {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 14px;
                color: #ffffff;
                font-size: 1.35rem;
                font-weight: 800;
                text-decoration: none;
            }

                .footer-logo i {
                    color: #ec4899;
                    font-size: 1.5rem;
                }

                .footer-logo span {
                    color: #ec4899;
                }

            .footer-brand p {
                max-width: 370px;
                margin: 0;
                color: #94a3b8;
                line-height: 1.7;
            }

            .footer-links h6,
            .footer-contact h6 {
                margin-bottom: 16px;
                color: #ffffff;
                font-size: 1rem;
                font-weight: 700;
            }

            .footer-links {
                display: flex;
                flex-direction: column;
                gap: 10px;
            }

                .footer-links a {
                    width: fit-content;
                    color: #cbd5e1;
                    text-decoration: none;
                    transition: color 0.2s ease, transform 0.2s ease;
                }

                    .footer-links a:hover {
                        color: #facc15;
                        transform: translateX(4px);
                    }

                .footer-links i,
                .footer-contact i {
                    margin-right: 7px;
                    color: #a78bfa;
                }

            .footer-contact p {
                margin-bottom: 12px;
                color: #94a3b8;
                line-height: 1.6;
                overflow-wrap: anywhere;
            }

            .footer-contact a {
                color: #cbd5e1;
                text-decoration: none;
            }

                .footer-contact a:hover {
                    color: #facc15;
                    text-decoration: underline;
                }

            .footer-bottom {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                padding: 20px 0;
                border-top: 1px solid rgba(255, 255, 255, 0.1);
                color: #94a3b8;
                font-size: 0.9rem;
            }

                .footer-bottom span {
                    overflow-wrap: anywhere;
                }

                .footer-bottom a {
                    flex-shrink: 0;
                    color: #facc15;
                    font-weight: 600;
                    text-decoration: none;
                }

                    .footer-bottom a:hover {
                        text-decoration: underline;
                    }

            /* =========================
                       TABLET AND MOBILE
                       ========================= */

            @@media (max-width: 991.98px) {
                .modern-navbar {
                    background: #0f172a;
                }

                .navbar-collapse {
                    padding: 12px 0 6px;
                }

                .navbar-nav {
                    width: 100%;
                    margin: 8px 0 18px !important;
                    text-align: center;
                }

                    .navbar-nav .nav-item {
                        width: 100%;
                    }

                .modern-link {
                    margin: 5px 0;
                }

                .auth-nav-area {
                    width: 100%;
                    flex-direction: column;
                    align-items: center;
                    justify-content: center;
                    gap: 12px;
                    padding: 18px 0 8px;
                    border-top: 1px solid rgba(255, 255, 255, 0.12);
                }

                .logged-user {
                    max-width: 100%;
                    text-align: center;
                    overflow-wrap: anywhere;
                }

                .login-btn {
                    min-width: 170px;
                }

                .footer-content {
                    grid-template-columns: repeat(2, 1fr);
                    gap: 35px;
                }

                .footer-brand {
                    grid-column: 1 / -1;
                }

                    .footer-brand p {
                        max-width: 600px;
                    }
            }

            @@media (max-width: 576px) {
                .brand-logo {
                    font-size: 1.22rem;
                    gap: 6px;
                }

                .brand-icon {
                    font-size: 1.4rem;
                }

                .footer-content {
                    grid-template-columns: 1fr;
                    gap: 28px;
                    padding: 32px 0 25px;
                    text-align: center;
                }

                .footer-brand {
                    grid-column: auto;
                }

                .footer-logo {
                    justify-content: center;
                }

                .footer-brand p {
                    margin: 0 auto;
                }

                .footer-links {
                    align-items: center;
                }

                .footer-bottom {
                    flex-direction: column;
                    justify-content: center;
                    padding: 16px 0;
                    text-align: center;
                    line-height: 1.6;
                }
            }

            @@media (max-width: 380px) {
                .brand-logo {
                    font-size: 1.1rem;
                }

                .login-btn {
                    width: 100%;
                    max-width: 220px;
                }
            }
    </style>
</head>

<body class="d-flex flex-column min-vh-100">

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg modern-navbar py-3">
            <div class="container">

                <a class="navbar-brand brand-logo"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-bag-heart-fill brand-icon"></i>
                    Ecommerce<span class="brand-accent">Cart</span>
                </a>

                <button class="navbar-toggler custom-toggler collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav mx-auto mb-3 mb-lg-0">

                        @if (User?.IsInRole("Admin") == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="AdminProduct"
                                   asp-action="Create">
                                    <i class="bi bi-plus-circle me-1"></i> Create Product
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="AdminProduct"
                                   asp-action="Index">
                                    <i class="bi bi-pencil-square me-1"></i> Update Product
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="AdminProduct"
                                   asp-action="Complaint">
                                    <i class="bi bi-chat-dots me-1"></i> Customer Complaints
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="Home"
                                   asp-action="Guide">
                                    <i class="bi bi-book me-1"></i> Guide
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    <i class="bi bi-house-door me-1"></i> Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="User"
                                   asp-action="Index">
                                    <i class="bi bi-grid me-1"></i> Products
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="AddToCart"
                                   asp-action="ViewCart">
                                    <i class="bi bi-cart3 me-1"></i> Cart
                                    <span class="cart-badge"></span>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="Home"
                                   asp-action="Contact">
                                    <i class="bi bi-telephone me-1"></i> Contact
                                </a>
                            </li>

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item">
                                    <a class="nav-link modern-link nav-close"
                                       asp-controller="Home"
                                       asp-action="Complaint">
                                        <i class="bi bi-chat-square-text me-1"></i> Complaint
                                    </a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="nav-link modern-link nav-close"
                                   asp-controller="Home"
                                   asp-action="Guide">
                                    <i class="bi bi-book me-1"></i> Guide
                                </a>
                            </li>
                        }

                    </ul>

                    <div class="auth-nav-area">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="logged-user">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name
                            </span>

                            <a class="btn login-btn nav-close"
                               asp-controller="Account"
                               asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a class="btn login-btn nav-close"
                               asp-controller="Account"
                               asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        }
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container">

            <div class="footer-content">

                <div class="footer-brand">
                    <a class="footer-logo"
                       asp-controller="Home"
                       asp-action="Index">
                        <i class="bi bi-bag-heart-fill"></i>
                        Ecommerce<span>Cart</span>
                    </a>

                    <p>
                        Browse products, manage your cart, and get support whenever you need it.
                    </p>
                </div>

                <div class="footer-links">
                    <h6>Quick Links</h6>

                    <a asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door"></i> Home
                    </a>

                    <a asp-controller="User" asp-action="Index">
                        <i class="bi bi-grid"></i> Products
                    </a>

                    <a asp-controller="Home" asp-action="Contact">
                        <i class="bi bi-telephone"></i> Contact
                    </a>

                    <a asp-controller="Home" asp-action="Guide">
                        <i class="bi bi-book"></i> Guide
                    </a>
                </div>

                <div class="footer-contact">
                    <h6>Need Help?</h6>

                    <p>
                        <i class="bi bi-envelope"></i>
                        <a href="mailto:support@ecommercecart.com">
                            support@ecommercecart.com
                        </a>
                    </p>

                    <p>
                        <i class="bi bi-chat-dots"></i>
                        Raise a complaint from your account.
                    </p>
                </div>

            </div>

            <div class="footer-bottom">
                <span>© 2026 EcommerceCart. All rights reserved by Developer Mohith.</span>

                <a asp-controller="Home" asp-action="Privacy">
                    Privacy Policy
                </a>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const navbar = document.getElementById("mainNavbar");
                const toggler = document.querySelector(".navbar-toggler");
                const navLinks = document.querySelectorAll(".nav-close");

                navLinks.forEach(function (link) {
                    link.addEventListener("click", function () {
                        if (window.innerWidth < 992 && navbar.classList.contains("show")) {
                            bootstrap.Collapse.getOrCreateInstance(navbar).hide();
                        }
                    });
                });

                navbar.addEventListener("hidden.bs.collapse", function () {
                    toggler.setAttribute("aria-expanded", "false");
                    toggler.classList.add("collapsed");
                });

                navbar.addEventListener("shown.bs.collapse", function () {
                    toggler.setAttribute("aria-expanded", "true");
                    toggler.classList.remove("collapsed");
                });
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>