<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ecommerce</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.styles.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <link rel="stylesheet"
 href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<style>
    .modern-navbar {
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
}

.brand-logo {
    font-size: 1.45rem;
    font-weight: 800;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    gap: 8px;
}

.brand-icon {
    color: #ec4899;
    font-size: 1.6rem;
}

.brand-accent {
    background: linear-gradient(90deg, #ec4899, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
}

.modern-link {
    color: #e2e8f0 !important;
    font-weight: 600;
    padding: 8px 16px !important;
    margin: 0 4px;
    border-radius: 50px;
    transition: all 0.25s ease;
}

.modern-link:hover,
.modern-link.active {
    color: #ffffff !important;
    background: linear-gradient(90deg, rgba(124, 58, 237, 0.85), rgba(236, 72, 153, 0.85));
    box-shadow: 0 8px 20px rgba(124, 58, 237, 0.35);
    transform: translateY(-2px);
}

.cart-badge {
    background-color: #facc15;
    color: #0f172a;
    font-size: 0.72rem;
    font-weight: 700;
    border-radius: 50px;
    padding: 2px 7px;
    margin-left: 4px;
}

.login-btn {
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50px;
    padding: 8px 22px;
    font-weight: 600;
    transition: all 0.25s ease;
}

.login-btn:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    transform: translateY(-2px);
}

.register-btn {
    background: linear-gradient(90deg, #7c3aed, #ec4899);
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 8px 22px;
    font-weight: 700;
    transition: all 0.25s ease;
}

.register-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(236, 72, 153, 0.4);
    color: #ffffff;
}

.custom-toggler {
    border-color: rgba(255, 255, 255, 0.4);
}

.custom-toggler .navbar-toggler-icon {
    filter: invert(1);
}

@@media (max-width: 991px) {
    .modern-navbar {
        background: rgba(15, 23, 42, 0.97);
    }

    .navbar-nav {
        text-align: center;
        margin-top: 15px;
    }

    .modern-link {
        display: inline-block;
        margin: 6px 0;
    }

    .d-flex.flex-column.flex-lg-row {
        margin-top: 15px;
        align-items: center;
    }
}

.auth-wrapper {
    min-height: calc(100vh - 190px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 15px;
}

.auth-card {
    width: 100%;
    max-width: 470px;
    padding: 40px 32px;
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(18px);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    animation: authFadeIn 0.6s ease;
}

.auth-icon {
    width: 78px;
    height: 78px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 2rem;
    color: #ffffff;
    background: linear-gradient(135deg, #7c3aed, #ec4899);
    box-shadow: 0 15px 35px rgba(124, 58, 237, 0.45);
}

.auth-title {
    text-align: center;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 6px;
}

.auth-subtitle {
    text-align: center;
    color: #cbd5e1;
    margin-bottom: 30px;
}

.auth-label {
    color: #e2e8f0;
    font-weight: 600;
    margin-bottom: 7px;
}

.input-box {
    position: relative;
}

.input-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: #a78bfa;
    z-index: 5;
}

.auth-input {
    width: 100%;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    border-radius: 14px;
    padding: 12px 15px 12px 45px;
    transition: all 0.25s ease;
}

.auth-input::placeholder {
    color: #94a3b8;
}

.auth-input:focus {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: #7c3aed;
    box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.25);
    color: #ffffff;
    outline: none;
}

.auth-btn {
    width: 100%;
    padding: 13px;
    border: none;
    border-radius: 50px;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(90deg, #7c3aed, #ec4899);
    transition: all 0.3s ease;
}

.auth-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(236, 72, 153, 0.4);
    color: #ffffff;
}

.auth-footer {
    text-align: center;
    margin-top: 22px;
    color: #cbd5e1;
}

.auth-footer a {
    color: #facc15;
    font-weight: 700;
    text-decoration: none;
}

.auth-footer a:hover {
    text-decoration: underline;
}

.validation-message {
    display: block;
    margin-top: 6px;
    font-size: 0.9rem;
    color: #fb7185;
}

.field-validation-error {
    color: #fb7185 !important;
}

.input-validation-error {
    border-color: #fb7185 !important;
    box-shadow: 0 0 0 3px rgba(251, 113, 133, 0.2);
}

@@media (max-width: 576px) {
    .auth-card {
        padding: 30px 20px;
    }
}

@@keyframes authFadeIn {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

</head>
<body>
   <header class="sticky-top">
    <nav class="navbar navbar-expand-lg modern-navbar py-3">
        <div class="container">

            <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                <i class="bi bi-bag-heart-fill brand-icon"></i>
                Ecommerce<span class="brand-accent">Cart</span>
            </a>

            <button class="navbar-toggler custom-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link modern-link active"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link modern-link"
                           asp-controller="Product" asp-action="Index">
                            <i class="bi bi-grid me-1"></i> Products
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link modern-link"
                           asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3 me-1"></i> Cart
                            <span class="cart-badge"></span>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link modern-link"
                           asp-controller="Home" asp-action="Contact">
                            <i class="bi bi-telephone me-1"></i> Contact
                        </a>
                    </li>
                </ul>

                <div class="d-flex flex-column flex-lg-row gap-2">
                    <a class="btn login-btn"
                       asp-controller="Account" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Login
                    </a>

                    <a class="btn register-btn"
                       asp-controller="Account" asp-action="Register">
                        <i class="bi bi-person-plus me-1"></i> Register
                    </a>
                </div>
            </div>

        </div>
    </nav>
</header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Ecommerce -All rights reserved by Developer Mohith <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
